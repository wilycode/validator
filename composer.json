{
    "name": "wilycode/validator",
    "description": "Framework-independent PHP validation contract with reusable validators and structured, nested errors.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\Validator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\Validator\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/examples",
            "/docs",
            "/benchmark",
            "/benchmarks",
            "/tools",
            "/phpunit.xml",
            "/phpunit.xml.dist",
            "/AGENTS.md",
            "/CHANGELOG.md",
            "/CONTRIBUTING.md",
            "/CODE_OF_CONDUCT.md",
            "/SECURITY.md",
            "/composer.lock",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon",
            "/phpstan.neon.dist",
            "/phpstan.*.neon",
            "/phpstan.*.neon.dist",
            "/pint.json",
            "/rector.php",
            "/psalm.xml",
            "/psalm.xml.dist",
            "/infection.json",
            "/infection.json.dist"
        ]
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml"
    },
    "keywords": [
        "validation",
        "validator",
        "errors",
        "php",
        "wilycode"
    ],
    "homepage": "https://github.com/wilycode/validator",
    "support": {
        "issues": "https://github.com/wilycode/validator/issues",
        "source": "https://github.com/wilycode/validator"
    }
}
